import { ScrollView, ListView, Button, LineEdit } from "std-widgets.slint";

export struct ChatMsg {
    role: string,
    author: string,
    content: string,
    reasoning: string,
    tool_calls: string,
    status: string,
    timestamp: string,
}

export struct SessionItem {
    id: string,
    name: string,
    /// Auto-derived topic: the first user line of the chat, empty until it has one.
    title: string,
    active: bool,
}

export struct FileItem {
    path: string,
    is_dir: bool,
}

component IconButton inherits Rectangle {
    in-out property <string> icon: "☰";
    in-out property <string> tip: "";
    in-out property <color> icon-color: #a1a1aa;
    callback clicked();

    width: 28px;
    height: 28px;
    border-radius: 4px;
    background: touch.pressed ? #262634 : (touch.has-hover ? #1e1e28 : transparent);

    Text {
        text: root.icon;
        color: touch.has-hover ? #ffffff : root.icon-color;
        font-size: 13px;
        vertical-alignment: center;
        horizontal-alignment: center;
        width: 100%;
        height: 100%;
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

component Splitter inherits Rectangle {
    in-out property <bool> is_active: touch.pressed || touch.has-hover;
    callback moved(length);

    width: 4px;
    background: touch.pressed ? #38bdf8 : (touch.has-hover ? #2dd4bf : #23232c);

    touch := TouchArea {
        mouse-cursor: ew-resize;
        moved => {
            root.moved(self.mouse-x - self.pressed-x);
        }
    }
}

component ProviderRow inherits Rectangle {
    in-out property <string> provider_name: "";
    in-out property <bool> is_active: false;
    in-out property <bool> is_current: false;
    callback clicked();
    callback scrolled(int);

    height: 28px;
    border-radius: 6px;
    background: touch.pressed ? #2c2c40 : (touch.has-hover ? #222234 : (root.is_current ? #1a1a28 : transparent));
    border-width: root.is_current ? 1px : 0px;
    border-color: root.is_current ? #2e2e46 : transparent;

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        alignment: space-between;

        HorizontalLayout {
            spacing: 8px;
            alignment: center;

            Text {
                text: root.is_active ? "●" : "";
                color: root.is_current ? #22c55e : #71717a;
                font-size: 8px;
                vertical-alignment: center;
            }

            Text {
                text: root.is_active ? root.provider_name : "";
                color: root.is_current ? #38bdf8 : #f4f4f5;
                font-size: 13px;
                font-weight: root.is_current ? 700 : 500;
                vertical-alignment: center;
            }

            if root.is_active && root.is_current : Text {
                text: "(active)";
                color: #52525b;
                font-size: 10px;
                vertical-alignment: center;
            }
        }

        Text {
            text: root.is_active ? "›" : "";
            color: #71717a;
            font-size: 14px;
            font-weight: 700;
            vertical-alignment: center;
        }
    }

    touch := TouchArea {
        enabled: root.is_active;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
        scroll-event(event) => {
            let step = event.delta_y < 0 ? 2 : -2;
            root.scrolled(step);
            return accept;
        }
    }
}

component ModelRow inherits Rectangle {
    in-out property <string> model_name: "";
    in-out property <bool> is_active: false;
    in-out property <bool> is_selected: false;
    callback clicked();
    callback scrolled(int);

    height: 24px;
    border-radius: 4px;
    background: touch.pressed ? #2c2c40 : (touch.has-hover ? #222232 : (root.is_selected ? #1e1e2c : transparent));

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        alignment: space-between;

        Text {
            text: root.is_active ? root.model_name : "";
            color: root.is_selected ? #38bdf8 : #e4e4e7;
            font-size: 12px;
            vertical-alignment: center;
            overflow: elide;
        }

        Text {
            text: (root.is_active && root.is_selected) ? "✓" : "";
            color: #38bdf8;
            font-size: 11px;
            font-weight: 700;
            vertical-alignment: center;
        }
    }

    touch := TouchArea {
        enabled: root.is_active;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
        scroll-event(event) => {
            let step = event.delta_y < 0 ? 3 : -3;
            root.scrolled(step);
            return accept;
        }
    }
}

export component AppWindow inherits Window {
    title: "Luna Desktop";
    min-width: 720px;
    min-height: 480px;
    preferred-width: 1280px;
    preferred-height: 800px;
    background: #121216;

    in-out property <[ChatMsg]> transcript: [];
    in-out property <[SessionItem]> sessions: [];
    in-out property <[FileItem]> files: [];

    in-out property <string> model_name: "gemini-3.8-flash";
    in-out property <string> current_provider: "antigravity";
    in-out property <string> selected_provider: "antigravity";
    in-out property <string> workspace_name: "rust-agent-harness";
    in-out property <string> workspace_path: "";
    in-out property <string> current_file: "crates/harness-gui/src/main.rs";
    in-out property <string> composer_text: "";
    in-out property <bool> is_sandboxed: true;
    in-out property <bool> is_generating: false;

    in-out property <bool> model_picker_open: false;
    in-out property <int> picker_step: 0;
    in-out property <string> model_filter: "";
    in-out property <int> model_scroll_index: 0;
    in-out property <int> provider_scroll_index: 0;

    in-out property <[string]> available_providers: ["antigravity", "nvidia"];
    in-out property <[string]> available_models: ["gemini-3.8-flash", "claude-sonnet-4-6", "claude-opus-4-6", "gpt-oss-120b"];

    in-out property <length> left_sidebar_width: 240px;
    in-out property <bool> left_sidebar_open: true;

    in-out property <length> right_sidebar_width: 240px;
    in-out property <bool> right_sidebar_open: true;

    callback submit_message(string);
    callback select_session(string);
    callback delete_session(string);
    callback delete_all_sessions();
    callback new_session();
    callback select_provider(string);
    callback select_model(string);
    callback filter_models(string);
    callback select_directory();

    VerticalLayout {
        padding: 0px;
        spacing: 0px;

        // --- Top Header Bar ---
        Rectangle {
            height: 38px;
            background: #141419;

            HorizontalLayout {
                padding-left: 12px;
                padding-right: 12px;
                alignment: space-between;

                // Left Brand & Navigation
                HorizontalLayout {
                    spacing: 10px;
                    alignment: start;

                    IconButton {
                        icon: "☰";
                        tip: root.left_sidebar_open ? "Close Sidebar" : "Open Sidebar";
                        icon-color: root.left_sidebar_open ? #38bdf8 : #a1a1aa;
                        y: 5px;
                        clicked => {
                            root.left_sidebar_open = !root.left_sidebar_open;
                        }
                    }

                    Text {
                        text: "☾ Luna";
                        color: #c084fc;
                        font-weight: 700;
                        font-size: 14px;
                        vertical-alignment: center;
                    }

                    Text {
                        text: "File   Edit   View   Terminal";
                        color: #71717a;
                        font-size: 12px;
                        vertical-alignment: center;
                    }
                }

                // Center Breadcrumbs in top bar
                HorizontalLayout {
                    spacing: 6px;
                    alignment: center;

                    Text {
                        text: root.workspace_name;
                        color: #a1a1aa;
                        font-size: 12px;
                        vertical-alignment: center;
                    }
                }

                // Right Status & Toggle
                HorizontalLayout {
                    spacing: 10px;
                    alignment: end;

                    Rectangle {
                        width: 8px;
                        height: 8px;
                        border-radius: 4px;
                        background: #22c55e;
                        y: 15px;
                    }
                    Text {
                        text: "Connected";
                        color: #71717a;
                        font-size: 11px;
                        vertical-alignment: center;
                    }

                    IconButton {
                        icon: "☰";
                        tip: root.right_sidebar_open ? "Close Context Panel" : "Open Context Panel";
                        icon-color: root.right_sidebar_open ? #38bdf8 : #a1a1aa;
                        y: 5px;
                        clicked => {
                            root.right_sidebar_open = !root.right_sidebar_open;
                        }
                    }
                }
            }
        }

        // Top Border Divider
        Rectangle {
            height: 1px;
            background: #23232c;
        }

        // --- Main Responsive 3-Column Body (Full Screen, No Gaps) ---
        HorizontalLayout {
            padding: 0px;
            spacing: 0px;
            vertical-stretch: 1;

            // 1. Left Sidebar
            if root.left_sidebar_open : Rectangle {
                width: root.left_sidebar_width;
                background: #15151c;

                VerticalLayout {
                    padding: 10px;
                    spacing: 8px;

                    // Header with title and chat actions (delete-all, new chat)
                    HorizontalLayout {
                        alignment: space-between;
                        padding-left: 2px;
                        padding-right: 2px;

                        Text {
                            text: "CHATS";
                            color: #71717a;
                            font-size: 10px;
                            font-weight: 700;
                            vertical-alignment: center;
                        }

                        HorizontalLayout {
                            spacing: 2px;

                            // Hidden on an empty list (nothing to clear — though `list()` always
                            // reports at least the open chat) and while a turn is generating: the
                            // running turn appends to its session, and `append` re-creates a
                            // missing session row instead of failing, so clearing mid-turn would
                            // resurrect the chat it just deleted.
                            if root.sessions.length > 0 && !root.is_generating : Rectangle {
                                width: 20px;
                                height: 20px;
                                border-radius: 4px;
                                background: clear_all_touch.has-hover ? #3a2430 : transparent;

                                Text {
                                    text: "🗑";
                                    color: clear_all_touch.has-hover ? #f87171 : #71717a;
                                    font-size: 11px;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                    width: 100%;
                                    height: 100%;
                                }

                                clear_all_touch := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => {
                                        clear_all_menu.show();
                                    }
                                }

                                // Clearing every chat cannot be undone, so the icon opens a
                                // confirmation instead of wiping on hover-click. A popup, not
                                // an inline panel: the CHATS list is a clipping ScrollView.
                                clear_all_menu := PopupWindow {
                                    width: 190px;
                                    height: 64px;
                                    x: -(self.width - clear_all_touch.width);
                                    y: 22px;
                                    close-policy: close-on-click-outside;

                                    Rectangle {
                                        width: 100%;
                                        height: 100%;
                                        border-radius: 8px;
                                        background: #1c1c28;
                                        border-width: 1px;
                                        border-color: #38384c;

                                        VerticalLayout {
                                            padding: 8px;
                                            spacing: 6px;

                                            Text {
                                                text: "Delete all {root.sessions.length} chats?";
                                                color: #f4f4f5;
                                                font-size: 12px;
                                                font-weight: 600;
                                                vertical-alignment: center;
                                            }

                                            HorizontalLayout {
                                                spacing: 6px;

                                                Rectangle {
                                                    horizontal-stretch: 1;
                                                    height: 22px;
                                                    border-radius: 4px;
                                                    background: cancel_all_touch.has-hover ? #2c2c40 : #252538;

                                                    Text {
                                                        text: "Cancel";
                                                        color: #a1a1aa;
                                                        font-size: 11px;
                                                        font-weight: 600;
                                                        horizontal-alignment: center;
                                                        vertical-alignment: center;
                                                        width: 100%;
                                                        height: 100%;
                                                    }

                                                    cancel_all_touch := TouchArea {
                                                        mouse-cursor: pointer;
                                                        clicked => {
                                                            clear_all_menu.close();
                                                        }
                                                    }
                                                }

                                                Rectangle {
                                                    horizontal-stretch: 1;
                                                    height: 22px;
                                                    border-radius: 4px;
                                                    background: confirm_all_touch.has-hover ? #991b1b : #7f1d1d;

                                                    Text {
                                                        text: "Delete all";
                                                        color: #fecaca;
                                                        font-size: 11px;
                                                        font-weight: 700;
                                                        horizontal-alignment: center;
                                                        vertical-alignment: center;
                                                        width: 100%;
                                                        height: 100%;
                                                    }

                                                    confirm_all_touch := TouchArea {
                                                        mouse-cursor: pointer;
                                                        clicked => {
                                                            clear_all_menu.close();
                                                            root.delete_all_sessions();
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }

                            Rectangle {
                                width: 20px;
                                height: 20px;
                                border-radius: 4px;
                                background: new_chat_touch.has-hover ? #252538 : transparent;

                                Text {
                                    text: "+";
                                    color: new_chat_touch.has-hover ? #38bdf8 : #a1a1aa;
                                    font-size: 14px;
                                    font-weight: 700;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                    width: 100%;
                                    height: 100%;
                                }

                                new_chat_touch := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => {
                                        root.new_session();
                                    }
                                }
                            }
                        }
                    }

                    // Sessions list
                    ScrollView {
                        vertical-stretch: 1;

                        VerticalLayout {
                            spacing: 2px;
                            alignment: start;

                            for sess in root.sessions : Rectangle {
                                height: 32px;
                                border-radius: 6px;
                                background: s_touch.pressed ? #2c2c40 : (s_touch.has-hover ? #222234 : (sess.active ? #1e1e2c : transparent));
                                border-width: sess.active ? 1px : 0px;
                                border-color: sess.active ? #2e2e46 : transparent;

                                HorizontalLayout {
                                    padding-left: 8px;
                                    // Right padding reserves the lane the chat-action (⋯) button sits in,
                                    // so a long name elides instead of running under it.
                                    padding-right: 34px;
                                    spacing: 8px;
                                    alignment: start;

                                    Text {
                                        text: "💬";
                                        font-size: 11px;
                                        vertical-alignment: center;
                                    }

                                    Text {
                                        // A `/name` beats the auto topic, which beats the raw id.
                                        text: sess.name != "" ? sess.name : (sess.title != "" ? sess.title : sess.id);
                                        color: sess.active ? #38bdf8 : (s_touch.has-hover ? #f4f4f5 : #a1a1aa);
                                        font-size: 12px;
                                        font-weight: sess.active ? 700 : 500;
                                        vertical-alignment: center;
                                        overflow: elide;
                                        horizontal-stretch: 1;
                                    }
                                }

                                // Selecting the chat is the row-wide default action. It is declared
                                // before the ⋯ button so that button, as a later sibling, still wins
                                // the click over its own area.
                                s_touch := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => {
                                        root.select_session(sess.id);
                                    }
                                }

                                // Per-chat actions: three dots opening a menu with Delete.
                                session_actions := Rectangle {
                                    x: parent.width - self.width - 5px;
                                    y: 5px;
                                    width: 24px;
                                    height: 22px;
                                    border-radius: 4px;
                                    background: session_actions_touch.pressed ? #2c2c40 : (session_actions_touch.has-hover ? #252538 : transparent);

                                    Text {
                                        text: "⋯";
                                        color: session_actions_touch.has-hover ? #f4f4f5 : #71717a;
                                        font-size: 15px;
                                        font-weight: 700;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                        width: 100%;
                                        height: 100%;
                                    }

                                    session_actions_touch := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => {
                                            session_menu.show();
                                        }
                                    }

                                    // A popup, not an in-row menu: the CHATS list lives in a
                                    // clipping ScrollView, so an inline menu would be cut off.
                                    session_menu := PopupWindow {
                                        width: 120px;
                                        height: 30px;
                                        x: -(self.width - session_actions.width);
                                        y: 24px;
                                        close-policy: close-on-click-outside;

                                        Rectangle {
                                            width: 100%;
                                            height: 100%;
                                            border-radius: 8px;
                                            background: #1c1c28;
                                            border-width: 1px;
                                            border-color: #38384c;

                                            HorizontalLayout {
                                                padding-left: 10px;
                                                padding-right: 10px;
                                                spacing: 8px;
                                                alignment: start;

                                                Text {
                                                    text: "🗑";
                                                    font-size: 12px;
                                                    vertical-alignment: center;
                                                }

                                                Text {
                                                    text: "Delete";
                                                    color: #f87171;
                                                    font-size: 12px;
                                                    font-weight: 600;
                                                    vertical-alignment: center;
                                                }
                                            }

                                            delete_touch := TouchArea {
                                                mouse-cursor: pointer;
                                                clicked => {
                                                    session_menu.close();
                                                    root.delete_session(sess.id);
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }

                    // Bottom Settings
                    Rectangle {
                        height: 32px;
                        border-radius: 6px;
                        background: transparent;

                        HorizontalLayout {
                            padding-left: 6px;
                            spacing: 8px;
                            Text {
                                text: "⚙";
                                color: #71717a;
                                font-size: 13px;
                                vertical-alignment: center;
                            }
                            Text {
                                text: "Settings";
                                color: #71717a;
                                font-size: 12px;
                                vertical-alignment: center;
                            }
                        }
                    }
                }
            }

            // Left Splitter (Resize handle)
            if root.left_sidebar_open : Splitter {
                moved(delta) => {
                    root.left_sidebar_width = max(140px, min(500px, root.left_sidebar_width + delta));
                }
            }

            // 2. Center Screen (Full screen, zero margin gaps to sidebars)
            center_area := Rectangle {
                horizontal-stretch: 1;
                vertical-stretch: 1;
                background: #101014;
                clip: true;

                // Scrollable Chat Message History
                ScrollView {
                    width: 100%;
                    height: 100%;

                    VerticalLayout {
                        padding: 24px;
                        padding-bottom: 150px;
                        spacing: 18px;
                        alignment: start;

                        for msg in root.transcript : VerticalLayout {
                            spacing: 8px;

                            // User message: Sleek card box
                            if msg.role == "user" : Rectangle {
                                background: #1b1b26;
                                border-radius: 12px;
                                border-width: 1px;
                                border-color: #2b2b3d;

                                VerticalLayout {
                                    padding: 12px;
                                    padding-left: 16px;
                                    padding-right: 16px;
                                    spacing: 6px;

                                    HorizontalLayout {
                                        alignment: space-between;

                                        Text {
                                            text: "You";
                                            color: #38bdf8;
                                            font-weight: 700;
                                            font-size: 11px;
                                        }

                                        Text {
                                            text: msg.timestamp;
                                            color: #52525b;
                                            font-size: 10px;
                                        }
                                    }

                                    Text {
                                        text: msg.content;
                                        color: #f4f4f5;
                                        font-size: 13px;
                                        wrap: word-wrap;
                                    }
                                }
                            }

                            // Assistant message: Antigravity unboxed typography
                            if msg.role != "user" : VerticalLayout {
                                padding-left: 4px;
                                padding-right: 4px;
                                spacing: 8px;

                                // Header
                                HorizontalLayout {
                                    alignment: start;
                                    spacing: 8px;

                                    Text {
                                        text: "✦ Luna";
                                        color: #c084fc;
                                        font-weight: 700;
                                        font-size: 12px;
                                        vertical-alignment: center;
                                    }

                                    Text {
                                        text: msg.timestamp;
                                        color: #52525b;
                                        font-size: 10px;
                                        vertical-alignment: center;
                                    }
                                }

                                // Live in-flight execution status badge
                                if msg.status != "" : Rectangle {
                                    height: 28px;
                                    border-radius: 6px;
                                    background: #141420;
                                    border-width: 1px;
                                    border-color: #2e2e46;

                                    HorizontalLayout {
                                        padding-left: 10px;
                                        padding-right: 10px;
                                        spacing: 6px;
                                        alignment: start;

                                        Text {
                                            text: "⚡";
                                            font-size: 11px;
                                            vertical-alignment: center;
                                        }

                                        Text {
                                            text: msg.status;
                                            color: #38bdf8;
                                            font-size: 11px;
                                            font-weight: 600;
                                            vertical-alignment: center;
                                            overflow: elide;
                                        }
                                    }
                                }

                                // Tool execution history details box
                                if msg.tool_calls != "" : Rectangle {
                                    border-radius: 6px;
                                    background: #13131c;
                                    border-width: 1px;
                                    border-color: #222230;

                                    VerticalLayout {
                                        padding: 10px;
                                        padding-left: 12px;
                                        padding-right: 12px;
                                        spacing: 6px;

                                        HorizontalLayout {
                                            alignment: space-between;

                                            Text {
                                                text: "TOOLS EXECUTED";
                                                color: #71717a;
                                                font-size: 9px;
                                                font-weight: 700;
                                            }
                                        }

                                        Text {
                                            text: msg.tool_calls;
                                            color: #a1a1aa;
                                            font-size: 11px;
                                            font-family: "monospace";
                                            wrap: word-wrap;
                                        }
                                    }
                                }

                                // Reasoning / Chain-of-thought block
                                if msg.reasoning != "" : Rectangle {
                                    border-radius: 6px;
                                    background: #111116;
                                    border-width: 1px;
                                    border-color: #1a1a24;

                                    VerticalLayout {
                                        padding: 8px;
                                        padding-left: 12px;
                                        padding-right: 12px;
                                        spacing: 4px;

                                        Text {
                                            text: "💭 Thinking";
                                            color: #71717a;
                                            font-size: 9px;
                                            font-weight: 700;
                                        }

                                        Text {
                                            text: msg.reasoning;
                                            color: #8b8b98;
                                            font-size: 11px;
                                            wrap: word-wrap;
                                        }
                                    }
                                }

                                // Final unboxed reply
                                if msg.content != "" : Text {
                                    text: msg.content;
                                    color: #e4e4e7;
                                    font-size: 13px;
                                    wrap: word-wrap;
                                }
                            }
                        }
                    }
                }

                // Floating Chat Box in Lower Part
                chat_box := Rectangle {
                    x: (parent.width - self.width) / 2;
                    y: parent.height - self.height - 20px;
                    width: min(720px, parent.width - 40px);
                    height: 84px;
                    border-radius: 12px;
                    background: #181822;
                    border-width: 1px;
                    border-color: #2e2e40;

                    VerticalLayout {
                        padding: 10px;
                        padding-left: 14px;
                        padding-right: 14px;
                        spacing: 8px;

                        // Top: Text Input Area
                        HorizontalLayout {
                            vertical-stretch: 1;

                            Rectangle {
                                horizontal-stretch: 1;

                                if root.composer_text == "" : Text {
                                    text: "Ask Luna anything or run tasks...";
                                    color: #52525b;
                                    font-size: 13px;
                                    vertical-alignment: center;
                                    x: 0px;
                                }

                                input := TextInput {
                                    width: 100%;
                                    height: 100%;
                                    text <=> root.composer_text;
                                    color: #f4f4f5;
                                    font-size: 13px;
                                    vertical-alignment: center;
                                    enabled: !root.is_generating;
                                    accepted => {
                                        if (root.composer_text != "" && !root.is_generating) {
                                            root.submit_message(root.composer_text);
                                            root.composer_text = "";
                                        }
                                    }
                                }
                            }
                        }

                        // Bottom Row: Model button on the left, Send button on the right
                        HorizontalLayout {
                            height: 26px;
                            alignment: space-between;

                            // Lower Left Cluster
                            HorizontalLayout {
                                spacing: 8px;
                                alignment: start;

                                model_btn := Rectangle {
                                    height: 24px;
                                    border-radius: 6px;
                                    background: model_touch.pressed ? #2c2c3e : (model_touch.has-hover ? #242434 : #1e1e2c);
                                    border-width: 1px;
                                    border-color: root.model_picker_open ? #38bdf8 : #2e2e42;

                                    HorizontalLayout {
                                        padding-left: 8px;
                                        padding-right: 8px;
                                        spacing: 6px;
                                        alignment: center;

                                        Text {
                                            text: "⚡ " + (root.current_provider != "" ? root.current_provider + " : " : "") + root.model_name;
                                            color: root.model_picker_open ? #38bdf8 : #e4e4e7;
                                            font-size: 11px;
                                            font-weight: 600;
                                            vertical-alignment: center;
                                        }

                                        Text {
                                            text: root.model_picker_open ? "▴" : "▾";
                                            color: #71717a;
                                            font-size: 9px;
                                            vertical-alignment: center;
                                        }
                                    }

                                    model_touch := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => {
                                            root.model_picker_open = !root.model_picker_open;
                                            if root.model_picker_open {
                                                root.picker_step = 0;
                                                root.model_filter = "";
                                                root.filter_models("");
                                                root.model_scroll_index = 0;
                                                root.provider_scroll_index = 0;
                                            }
                                        }
                                    }
                                }
                            }

                            // Lower Right: Send button
                            send_btn := Rectangle {
                                width: 26px;
                                height: 24px;
                                border-radius: 6px;
                                background: (root.composer_text != "" && !root.is_generating) ? #38bdf8 : #242434;

                                Text {
                                    text: root.is_generating ? "…" : "↑";
                                    color: (root.composer_text != "" && !root.is_generating) ? #000000 : #71717a;
                                    font-size: 13px;
                                    font-weight: 700;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                    width: 100%;
                                    height: 100%;
                                }

                                TouchArea {
                                    enabled: !root.is_generating;
                                    mouse-cursor: pointer;
                                    clicked => {
                                        if (root.composer_text != "" && !root.is_generating) {
                                            root.submit_message(root.composer_text);
                                            root.composer_text = "";
                                        }
                                    }
                                }
                            }
                        }
                    }
                }

                // Floating Directory Selector (Outside & Above Chat Box)
                dir_btn := Rectangle {
                    x: chat_box.x;
                    y: chat_box.y - self.height - 8px;
                    width: 108px;
                    height: 26px;
                    border-radius: 6px;
                    background: dir_touch.pressed ? #2c2c3e : (dir_touch.has-hover ? #242434 : #181822);
                    border-width: 1px;
                    border-color: dir_touch.has-hover ? #38bdf8 : #2e2e42;

                    HorizontalLayout {
                        padding-left: 9px;
                        padding-right: 9px;
                        spacing: 6px;
                        alignment: center;

                        // Crisp vector folder icon
                        Rectangle {
                            width: 13px;
                            height: 11px;
                            y: 7px;

                            // Folder tab
                            Rectangle {
                                x: 0px;
                                y: 0px;
                                width: 5px;
                                height: 3px;
                                background: dir_touch.has-hover ? #38bdf8 : #a1a1aa;
                                border-top-left-radius: 1px;
                                border-top-right-radius: 1px;
                            }
                            // Folder body
                            Rectangle {
                                x: 0px;
                                y: 2px;
                                width: 13px;
                                height: 9px;
                                border-radius: 2px;
                                background: dir_touch.has-hover ? #38bdf8 : #a1a1aa;
                            }
                        }

                        Text {
                            text: root.workspace_name;
                            color: dir_touch.has-hover ? #38bdf8 : #f4f4f5;
                            font-size: 11px;
                            font-weight: 600;
                            vertical-alignment: center;
                            overflow: elide;
                            max-width: 65px;
                        }

                        Text {
                            text: "▾";
                            color: #71717a;
                            font-size: 9px;
                            vertical-alignment: center;
                        }
                    }

                    dir_touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            root.select_directory();
                        }
                    }
                }

                // Backdrop to close picker on outside click
                TouchArea {
                    visible: root.model_picker_open;
                    width: 100%;
                    height: 100%;
                    clicked => {
                        root.model_picker_open = false;
                    }
                }

                // Anchored Dropdown Menu for Provider -> Model Selection
                Rectangle {
                    visible: root.model_picker_open;
                    x: max(16px, min(parent.width - self.width - 16px, chat_box.x + 12px));
                    y: max(16px, chat_box.y - self.height - 8px);
                    width: 300px;
                    height: 250px;
                    border-radius: 10px;
                    background: #181822;
                    border-width: 1px;
                    border-color: #38384c;
                    clip: true;

                    // STEP 0: Provider Picker
                    if root.picker_step == 0 : VerticalLayout {
                        padding: 8px;
                        spacing: 6px;

                        // Provider List (handles any number of providers cleanly with wheel & drag scroll)
                        Rectangle {
                            vertical-stretch: 1;

                            prov_wheel_touch := TouchArea {
                                width: 100%;
                                height: 100%;
                                scroll-event(event) => {
                                    let max_scroll = max(0, root.available_providers.length - 7);
                                    let step = event.delta_y < 0 ? 2 : -2;
                                    root.provider_scroll_index = max(0, min(max_scroll, root.provider_scroll_index + step));
                                    return accept;
                                }
                            }

                            HorizontalLayout {
                                width: 100%;
                                height: 100%;
                                spacing: 4px;

                                VerticalLayout {
                                    horizontal-stretch: 1;
                                    spacing: 2px;

                                    for offset in 7 : ProviderRow {
                                        property <int> item_idx: root.provider_scroll_index + offset;
                                        is_active: item_idx >= 0 && item_idx < root.available_providers.length;
                                        provider_name: self.is_active ? root.available_providers[item_idx] : "";
                                        is_current: self.is_active && root.current_provider == self.provider_name;
                                        clicked => {
                                            if self.is_active {
                                                root.select_provider(self.provider_name);
                                                root.model_filter = "";
                                                root.filter_models("");
                                                root.model_scroll_index = 0;
                                                root.picker_step = 1;
                                            }
                                        }
                                        scrolled(step) => {
                                            let max_scroll = max(0, root.available_providers.length - 7);
                                            root.provider_scroll_index = max(0, min(max_scroll, root.provider_scroll_index + step));
                                        }
                                    }
                                }

                                if root.available_providers.length > 7 : Rectangle {
                                    width: 6px;
                                    background: #14141e;
                                    border-radius: 3px;

                                    prov_thumb := Rectangle {
                                        width: 6px;
                                        y: (parent.height - self.height) * root.provider_scroll_index / max(1, root.available_providers.length - 7);
                                        height: max(24px, parent.height * 7 / max(1, root.available_providers.length));
                                        border-radius: 3px;
                                        background: prov_scroll_touch.pressed ? #38bdf8 : #4a4a62;
                                    }

                                    prov_scroll_touch := TouchArea {
                                        mouse-cursor: pointer;
                                        moved => {
                                            let max_scroll = max(0, root.available_providers.length - 7);
                                            let avail_h = max(1px, parent.height - prov_thumb.height);
                                            let pos = max(0px, min(avail_h, self.mouse-y));
                                            root.provider_scroll_index = min(max_scroll, max(0, round(pos / avail_h * max_scroll)));
                                        }
                                        clicked => {
                                            let max_scroll = max(0, root.available_providers.length - 7);
                                            let avail_h = max(1px, parent.height - prov_thumb.height);
                                            let pos = max(0px, min(avail_h, self.mouse-y));
                                            root.provider_scroll_index = min(max_scroll, max(0, round(pos / avail_h * max_scroll)));
                                        }
                                    }
                                }
                            }
                        }
                    }

                    // STEP 1: Model Picker
                    if root.picker_step == 1 : VerticalLayout {
                        padding: 8px;
                        spacing: 6px;

                        // Instant search filter input. The back-to-providers control lives inline
                        // here so the picker needs no header row.
                        Rectangle {
                            height: 26px;
                            border-radius: 4px;
                            background: #13131c;
                            border-width: 1px;
                            border-color: filter_input.has-focus ? #38bdf8 : #282838;

                            HorizontalLayout {
                                padding-left: 6px;
                                padding-right: 8px;
                                spacing: 6px;

                                back_btn := Rectangle {
                                    width: 16px;
                                    height: 16px;
                                    border-radius: 4px;
                                    background: back_touch.has-hover ? #252538 : transparent;

                                    Text {
                                        text: "‹";
                                        color: back_touch.has-hover ? #38bdf8 : #a1a1aa;
                                        font-size: 13px;
                                        font-weight: 700;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                        width: 100%;
                                        height: 100%;
                                    }

                                    back_touch := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => {
                                            root.picker_step = 0;
                                        }
                                    }
                                }

                                Text {
                                    text: "🔍";
                                    font-size: 10px;
                                    vertical-alignment: center;
                                }

                                filter_input := TextInput {
                                    text <=> root.model_filter;
                                    color: #f4f4f5;
                                    font-size: 11px;
                                    vertical-alignment: center;
                                    edited => {
                                        root.filter_models(self.text);
                                    }
                                }

                                if root.model_filter != "" : Rectangle {
                                    width: 16px;
                                    height: 16px;
                                    border-radius: 8px;
                                    background: clear_touch.has-hover ? #2e2e42 : transparent;

                                    Text {
                                        text: "✕";
                                        color: #71717a;
                                        font-size: 9px;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                        width: 100%;
                                        height: 100%;
                                    }

                                    clear_touch := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => {
                                            root.model_filter = "";
                                            root.filter_models("");
                                        }
                                    }
                                }
                            }
                        }

                        // Static 8-row viewport with direct row wheel forwarding and drag scrollbar
                        Rectangle {
                            vertical-stretch: 1;

                            wheel_touch := TouchArea {
                                width: 100%;
                                height: 100%;
                                scroll-event(event) => {
                                    let max_scroll = max(0, root.available_models.length - 8);
                                    let step = event.delta_y < 0 ? 3 : -3;
                                    root.model_scroll_index = max(0, min(max_scroll, root.model_scroll_index + step));
                                    return accept;
                                }
                            }

                            HorizontalLayout {
                                width: 100%;
                                height: 100%;
                                spacing: 4px;

                                VerticalLayout {
                                    horizontal-stretch: 1;
                                    spacing: 1px;

                                    for offset in 8 : ModelRow {
                                        property <int> item_idx: root.model_scroll_index + offset;
                                        is_active: item_idx >= 0 && item_idx < root.available_models.length;
                                        model_name: self.is_active ? root.available_models[item_idx] : "";
                                        is_selected: self.is_active && root.model_name == self.model_name;
                                        clicked => {
                                            if self.is_active {
                                                root.select_model(self.model_name);
                                            }
                                        }
                                        scrolled(step) => {
                                            let max_scroll = max(0, root.available_models.length - 8);
                                            root.model_scroll_index = max(0, min(max_scroll, root.model_scroll_index + step));
                                        }
                                    }
                                }

                                if root.available_models.length > 8 : Rectangle {
                                    width: 6px;
                                    background: #14141e;
                                    border-radius: 3px;

                                    thumb := Rectangle {
                                        width: 6px;
                                        y: (parent.height - self.height) * root.model_scroll_index / max(1, root.available_models.length - 8);
                                        height: max(24px, parent.height * 8 / max(1, root.available_models.length));
                                        border-radius: 3px;
                                        background: scroll_touch.pressed ? #38bdf8 : #4a4a62;
                                    }

                                    scroll_touch := TouchArea {
                                        mouse-cursor: pointer;
                                        moved => {
                                            let max_scroll = max(0, root.available_models.length - 8);
                                            let avail_h = max(1px, parent.height - thumb.height);
                                            let pos = max(0px, min(avail_h, self.mouse-y));
                                            root.model_scroll_index = min(max_scroll, max(0, round(pos / avail_h * max_scroll)));
                                        }
                                        clicked => {
                                            let max_scroll = max(0, root.available_models.length - 8);
                                            let avail_h = max(1px, parent.height - thumb.height);
                                            let pos = max(0px, min(avail_h, self.mouse-y));
                                            root.model_scroll_index = min(max_scroll, max(0, round(pos / avail_h * max_scroll)));
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }

            // Right Splitter (Resize handle)
            if root.right_sidebar_open : Splitter {
                moved(delta) => {
                    root.right_sidebar_width = max(140px, min(500px, root.right_sidebar_width - delta));
                }
            }

            // 3. Right Sidebar
            if root.right_sidebar_open : Rectangle {
                width: root.right_sidebar_width;
                background: #15151c;

                VerticalLayout {
                    padding: 10px;
                    spacing: 8px;

                    // Header with title
                    HorizontalLayout {
                        alignment: start;
                        Text {
                            text: "CONTEXT";
                            color: #71717a;
                            font-size: 10px;
                            font-weight: 700;
                            vertical-alignment: center;
                        }
                    }

                    // Clean empty context panel body
                    Rectangle {
                        vertical-stretch: 1;
                    }
                }
            }
        }
    }
}
