{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Luna",
  "version": "0.1.8",
  "identifier": "ai.luna.desktop",
  "build": {
    "beforeDevCommand": "npm --prefix ../../gui run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm --prefix ../../gui run build",
    "frontendDist": "../../gui/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Luna",
        "width": 1280,
        "height": 840,
        "minWidth": 900,
        "minHeight": 620,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.png"
    ]
  }
}
