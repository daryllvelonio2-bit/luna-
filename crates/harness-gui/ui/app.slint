import { ScrollView, Button, LineEdit } from "std-widgets.slint";

export struct ChatMsg {
    role: string,
    author: string,
    content: string,
    timestamp: string,
}

export struct SessionItem {
    id: string,
    name: string,
    active: bool,
}

export struct FileItem {
    path: string,
    is_dir: bool,
}

component IconButton inherits Rectangle {
    in-out property <string> icon: "☰";
    in-out property <string> tip: "";
    in-out property <color> icon-color: #a1a1aa;
    callback clicked();

    width: 28px;
    height: 28px;
    border-radius: 4px;
    background: touch.pressed ? #262634 : (touch.has-hover ? #1e1e28 : transparent);

    Text {
        text: root.icon;
        color: touch.has-hover ? #ffffff : root.icon-color;
        font-size: 13px;
        vertical-alignment: center;
        horizontal-alignment: center;
        width: 100%;
        height: 100%;
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

component Splitter inherits Rectangle {
    in-out property <bool> is_active: touch.pressed || touch.has-hover;
    callback moved(length);

    width: 4px;
    background: touch.pressed ? #38bdf8 : (touch.has-hover ? #2dd4bf : #23232c);

    touch := TouchArea {
        mouse-cursor: ew-resize;
        moved => {
            root.moved(self.mouse-x - self.pressed-x);
        }
    }
}

export component AppWindow inherits Window {
    title: "Luna Desktop";
    min-width: 720px;
    min-height: 480px;
    preferred-width: 1280px;
    preferred-height: 800px;
    background: #121216;

    in-out property <[ChatMsg]> transcript: [];
    in-out property <[SessionItem]> sessions: [];
    in-out property <[FileItem]> files: [];

    in-out property <string> model_name: "Gemini 3.8 Flash High";
    in-out property <string> workspace_name: "rust-agent-harness";
    in-out property <string> current_file: "crates/harness-gui/src/main.rs";
    in-out property <string> composer_text: "";

    in-out property <length> left_sidebar_width: 240px;
    in-out property <bool> left_sidebar_open: true;

    in-out property <length> right_sidebar_width: 240px;
    in-out property <bool> right_sidebar_open: true;

    callback submit_message(string);
    callback select_session(string);
    callback new_session();

    VerticalLayout {
        padding: 0px;
        spacing: 0px;

        // --- Top Header Bar ---
        Rectangle {
            height: 38px;
            background: #141419;

            HorizontalLayout {
                padding-left: 12px;
                padding-right: 12px;
                alignment: space-between;

                // Left Brand & Navigation
                HorizontalLayout {
                    spacing: 10px;
                    alignment: start;

                    IconButton {
                        icon: "☰";
                        tip: root.left_sidebar_open ? "Close Sidebar" : "Open Sidebar";
                        icon-color: root.left_sidebar_open ? #38bdf8 : #a1a1aa;
                        y: 5px;
                        clicked => {
                            root.left_sidebar_open = !root.left_sidebar_open;
                        }
                    }

                    Text {
                        text: "☾ Luna";
                        color: #c084fc;
                        font-weight: 700;
                        font-size: 14px;
                        vertical-alignment: center;
                    }

                    Text {
                        text: "File   Edit   View   Terminal";
                        color: #71717a;
                        font-size: 12px;
                        vertical-alignment: center;
                    }
                }

                // Center Breadcrumbs in top bar
                HorizontalLayout {
                    spacing: 6px;
                    alignment: center;

                    Text {
                        text: root.workspace_name;
                        color: #a1a1aa;
                        font-size: 12px;
                        vertical-alignment: center;
                    }
                    Text {
                        text: "›";
                        color: #52525b;
                        font-size: 12px;
                        vertical-alignment: center;
                    }
                    Text {
                        text: root.current_file;
                        color: #f4f4f5;
                        font-size: 12px;
                        font-weight: 500;
                        vertical-alignment: center;
                    }
                }

                // Right Status & Toggle
                HorizontalLayout {
                    spacing: 10px;
                    alignment: end;

                    Rectangle {
                        width: 8px;
                        height: 8px;
                        border-radius: 4px;
                        background: #22c55e;
                        y: 15px;
                    }
                    Text {
                        text: "Connected";
                        color: #71717a;
                        font-size: 11px;
                        vertical-alignment: center;
                    }

                    IconButton {
                        icon: "☰";
                        tip: root.right_sidebar_open ? "Close Context Panel" : "Open Context Panel";
                        icon-color: root.right_sidebar_open ? #38bdf8 : #a1a1aa;
                        y: 5px;
                        clicked => {
                            root.right_sidebar_open = !root.right_sidebar_open;
                        }
                    }
                }
            }
        }

        // Top Border Divider
        Rectangle {
            height: 1px;
            background: #23232c;
        }

        // --- Main Responsive 3-Column Body (Full Screen, No Gaps) ---
        HorizontalLayout {
            padding: 0px;
            spacing: 0px;
            vertical-stretch: 1;

            // 1. Left Sidebar
            if root.left_sidebar_open : Rectangle {
                width: root.left_sidebar_width;
                background: #15151c;

                VerticalLayout {
                    padding: 10px;
                    spacing: 8px;

                    // Header with title
                    HorizontalLayout {
                        alignment: start;
                        Text {
                            text: "EXPLORER";
                            color: #71717a;
                            font-size: 10px;
                            font-weight: 700;
                            vertical-alignment: center;
                        }
                    }

                    // Clean empty explorer body
                    Rectangle {
                        vertical-stretch: 1;
                    }

                    // Bottom Settings
                    Rectangle {
                        height: 32px;
                        border-radius: 6px;
                        background: transparent;

                        HorizontalLayout {
                            padding-left: 6px;
                            spacing: 8px;
                            Text {
                                text: "⚙";
                                color: #71717a;
                                font-size: 13px;
                                vertical-alignment: center;
                            }
                            Text {
                                text: "Settings";
                                color: #71717a;
                                font-size: 12px;
                                vertical-alignment: center;
                            }
                        }
                    }
                }
            }

            // Left Splitter (Resize handle)
            if root.left_sidebar_open : Splitter {
                moved(delta) => {
                    root.left_sidebar_width = max(140px, min(500px, root.left_sidebar_width + delta));
                }
            }

            // 2. Center Screen (Full screen, zero margin gaps to sidebars)
            Rectangle {
                horizontal-stretch: 1;
                vertical-stretch: 1;
                background: #101014;
            }

            // Right Splitter (Resize handle)
            if root.right_sidebar_open : Splitter {
                moved(delta) => {
                    root.right_sidebar_width = max(140px, min(500px, root.right_sidebar_width - delta));
                }
            }

            // 3. Right Sidebar
            if root.right_sidebar_open : Rectangle {
                width: root.right_sidebar_width;
                background: #15151c;

                VerticalLayout {
                    padding: 10px;
                    spacing: 8px;

                    // Header with title
                    HorizontalLayout {
                        alignment: start;
                        Text {
                            text: "CONTEXT";
                            color: #71717a;
                            font-size: 10px;
                            font-weight: 700;
                            vertical-alignment: center;
                        }
                    }

                    // Clean empty context panel body
                    Rectangle {
                        vertical-stretch: 1;
                    }
                }
            }
        }
    }
}
