import { ScrollView, ListView, Button, LineEdit } from "std-widgets.slint";

export struct ChatMsg {
    role: string,
    author: string,
    content: string,
    timestamp: string,
}

export struct SessionItem {
    id: string,
    name: string,
    active: bool,
}

export struct FileItem {
    path: string,
    is_dir: bool,
}

component IconButton inherits Rectangle {
    in-out property <string> icon: "☰";
    in-out property <string> tip: "";
    in-out property <color> icon-color: #a1a1aa;
    callback clicked();

    width: 28px;
    height: 28px;
    border-radius: 4px;
    background: touch.pressed ? #262634 : (touch.has-hover ? #1e1e28 : transparent);

    Text {
        text: root.icon;
        color: touch.has-hover ? #ffffff : root.icon-color;
        font-size: 13px;
        vertical-alignment: center;
        horizontal-alignment: center;
        width: 100%;
        height: 100%;
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

component Splitter inherits Rectangle {
    in-out property <bool> is_active: touch.pressed || touch.has-hover;
    callback moved(length);

    width: 4px;
    background: touch.pressed ? #38bdf8 : (touch.has-hover ? #2dd4bf : #23232c);

    touch := TouchArea {
        mouse-cursor: ew-resize;
        moved => {
            root.moved(self.mouse-x - self.pressed-x);
        }
    }
}

component ModelRow inherits Rectangle {
    in-out property <string> model_name: "";
    in-out property <bool> is_active: false;
    in-out property <bool> is_selected: false;
    callback clicked();
    callback scrolled(int);

    height: 26px;
    border-radius: 4px;
    background: touch.pressed ? #2c2c40 : (touch.has-hover ? #222232 : (root.is_selected ? #1e1e2c : transparent));

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        alignment: space-between;

        Text {
            text: root.is_active ? root.model_name : "";
            color: root.is_selected ? #38bdf8 : #e4e4e7;
            font-size: 12px;
            vertical-alignment: center;
            overflow: elide;
        }

        Text {
            text: (root.is_active && root.is_selected) ? "✓" : "";
            color: #38bdf8;
            font-size: 11px;
            font-weight: 700;
            vertical-alignment: center;
        }
    }

    touch := TouchArea {
        enabled: root.is_active;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
        scroll-event(event) => {
            let step = event.delta_y < 0 ? 3 : -3;
            root.scrolled(step);
            return accept;
        }
    }
}

export component AppWindow inherits Window {
    title: "Luna Desktop";
    min-width: 720px;
    min-height: 480px;
    preferred-width: 1280px;
    preferred-height: 800px;
    background: #121216;

    in-out property <[ChatMsg]> transcript: [];
    in-out property <[SessionItem]> sessions: [];
    in-out property <[FileItem]> files: [];

    in-out property <string> model_name: "gemini-3.8-flash";
    in-out property <string> current_provider: "antigravity";
    in-out property <string> selected_provider: "antigravity";
    in-out property <string> workspace_name: "rust-agent-harness";
    in-out property <string> workspace_path: "";
    in-out property <string> current_file: "crates/harness-gui/src/main.rs";
    in-out property <string> composer_text: "";
    in-out property <bool> is_sandboxed: true;

    in-out property <bool> model_picker_open: false;
    in-out property <string> model_filter: "";
    in-out property <int> model_scroll_index: 0;

    in-out property <[string]> available_providers: ["antigravity", "nvidia"];
    in-out property <[string]> available_models: ["gemini-3.8-flash", "claude-sonnet-4-6", "claude-opus-4-6", "gpt-oss-120b"];

    in-out property <length> left_sidebar_width: 240px;
    in-out property <bool> left_sidebar_open: true;

    in-out property <length> right_sidebar_width: 240px;
    in-out property <bool> right_sidebar_open: true;

    callback submit_message(string);
    callback select_session(string);
    callback new_session();
    callback select_provider(string);
    callback select_model(string);
    callback filter_models(string);
    callback select_directory();

    VerticalLayout {
        padding: 0px;
        spacing: 0px;

        // --- Top Header Bar ---
        Rectangle {
            height: 38px;
            background: #141419;

            HorizontalLayout {
                padding-left: 12px;
                padding-right: 12px;
                alignment: space-between;

                // Left Brand & Navigation
                HorizontalLayout {
                    spacing: 10px;
                    alignment: start;

                    IconButton {
                        icon: "☰";
                        tip: root.left_sidebar_open ? "Close Sidebar" : "Open Sidebar";
                        icon-color: root.left_sidebar_open ? #38bdf8 : #a1a1aa;
                        y: 5px;
                        clicked => {
                            root.left_sidebar_open = !root.left_sidebar_open;
                        }
                    }

                    Text {
                        text: "☾ Luna";
                        color: #c084fc;
                        font-weight: 700;
                        font-size: 14px;
                        vertical-alignment: center;
                    }

                    Text {
                        text: "File   Edit   View   Terminal";
                        color: #71717a;
                        font-size: 12px;
                        vertical-alignment: center;
                    }
                }

                // Center Breadcrumbs in top bar
                HorizontalLayout {
                    spacing: 6px;
                    alignment: center;

                    Text {
                        text: root.workspace_name;
                        color: #a1a1aa;
                        font-size: 12px;
                        vertical-alignment: center;
                    }
                }

                // Right Status & Toggle
                HorizontalLayout {
                    spacing: 10px;
                    alignment: end;

                    Rectangle {
                        width: 8px;
                        height: 8px;
                        border-radius: 4px;
                        background: #22c55e;
                        y: 15px;
                    }
                    Text {
                        text: "Connected";
                        color: #71717a;
                        font-size: 11px;
                        vertical-alignment: center;
                    }

                    IconButton {
                        icon: "☰";
                        tip: root.right_sidebar_open ? "Close Context Panel" : "Open Context Panel";
                        icon-color: root.right_sidebar_open ? #38bdf8 : #a1a1aa;
                        y: 5px;
                        clicked => {
                            root.right_sidebar_open = !root.right_sidebar_open;
                        }
                    }
                }
            }
        }

        // Top Border Divider
        Rectangle {
            height: 1px;
            background: #23232c;
        }

        // --- Main Responsive 3-Column Body (Full Screen, No Gaps) ---
        HorizontalLayout {
            padding: 0px;
            spacing: 0px;
            vertical-stretch: 1;

            // 1. Left Sidebar
            if root.left_sidebar_open : Rectangle {
                width: root.left_sidebar_width;
                background: #15151c;

                VerticalLayout {
                    padding: 10px;
                    spacing: 8px;

                    // Header with title
                    HorizontalLayout {
                        alignment: start;
                        Text {
                            text: "EXPLORER";
                            color: #71717a;
                            font-size: 10px;
                            font-weight: 700;
                            vertical-alignment: center;
                        }
                    }

                    // Clean empty explorer body
                    Rectangle {
                        vertical-stretch: 1;
                    }

                    // Bottom Settings
                    Rectangle {
                        height: 32px;
                        border-radius: 6px;
                        background: transparent;

                        HorizontalLayout {
                            padding-left: 6px;
                            spacing: 8px;
                            Text {
                                text: "⚙";
                                color: #71717a;
                                font-size: 13px;
                                vertical-alignment: center;
                            }
                            Text {
                                text: "Settings";
                                color: #71717a;
                                font-size: 12px;
                                vertical-alignment: center;
                            }
                        }
                    }
                }
            }

            // Left Splitter (Resize handle)
            if root.left_sidebar_open : Splitter {
                moved(delta) => {
                    root.left_sidebar_width = max(140px, min(500px, root.left_sidebar_width + delta));
                }
            }

            // 2. Center Screen (Full screen, zero margin gaps to sidebars)
            center_area := Rectangle {
                horizontal-stretch: 1;
                vertical-stretch: 1;
                background: #101014;
                clip: true;

                // Scrollable Chat Message History
                ScrollView {
                    width: 100%;
                    height: 100%;

                    VerticalLayout {
                        padding: 20px;
                        padding-bottom: 100px;
                        spacing: 12px;
                        alignment: start;

                        for msg in root.transcript : Rectangle {
                            background: msg.role == "user" ? #191924 : #14141d;
                            border-radius: 8px;
                            border-width: 1px;
                            border-color: msg.role == "user" ? #28283a : #20202e;

                            VerticalLayout {
                                padding: 12px;
                                spacing: 6px;

                                HorizontalLayout {
                                    alignment: space-between;
                                    Text {
                                        text: msg.author;
                                        color: msg.role == "user" ? #38bdf8 : #c084fc;
                                        font-weight: 700;
                                        font-size: 11px;
                                    }
                                    Text {
                                        text: msg.timestamp;
                                        color: #52525b;
                                        font-size: 10px;
                                    }
                                }

                                Text {
                                    text: msg.content;
                                    color: #e4e4e7;
                                    font-size: 13px;
                                    wrap: word-wrap;
                                }
                            }
                        }
                    }
                }

                // Floating Chat Box in Lower Part
                chat_box := Rectangle {
                    x: (parent.width - self.width) / 2;
                    y: parent.height - self.height - 20px;
                    width: min(720px, parent.width - 40px);
                    height: 84px;
                    border-radius: 12px;
                    background: #181822;
                    border-width: 1px;
                    border-color: #2e2e40;

                    VerticalLayout {
                        padding: 10px;
                        padding-left: 14px;
                        padding-right: 14px;
                        spacing: 8px;

                        // Top: Text Input Area
                        HorizontalLayout {
                            vertical-stretch: 1;

                            Rectangle {
                                horizontal-stretch: 1;

                                if root.composer_text == "" : Text {
                                    text: "Ask Luna anything or run tasks...";
                                    color: #52525b;
                                    font-size: 13px;
                                    vertical-alignment: center;
                                    x: 0px;
                                }

                                input := TextInput {
                                    width: 100%;
                                    height: 100%;
                                    text <=> root.composer_text;
                                    color: #f4f4f5;
                                    font-size: 13px;
                                    vertical-alignment: center;
                                    accepted => {
                                        if (root.composer_text != "") {
                                            root.submit_message(root.composer_text);
                                            root.composer_text = "";
                                        }
                                    }
                                }
                            }
                        }

                        // Bottom Row: Lower Left has Model Button and Send Icon right next to each other
                        HorizontalLayout {
                            height: 26px;
                            alignment: space-between;

                            // Lower Left Cluster
                            HorizontalLayout {
                                spacing: 8px;
                                alignment: start;

                                model_btn := Rectangle {
                                    height: 24px;
                                    border-radius: 6px;
                                    background: model_touch.pressed ? #2c2c3e : (model_touch.has-hover ? #242434 : #1e1e2c);
                                    border-width: 1px;
                                    border-color: root.model_picker_open ? #38bdf8 : #2e2e42;

                                    HorizontalLayout {
                                        padding-left: 8px;
                                        padding-right: 8px;
                                        spacing: 6px;
                                        alignment: center;

                                        Text {
                                            text: "⚡ " + (root.current_provider != "" ? root.current_provider + " : " : "") + root.model_name;
                                            color: root.model_picker_open ? #38bdf8 : #e4e4e7;
                                            font-size: 11px;
                                            font-weight: 600;
                                            vertical-alignment: center;
                                        }

                                        Text {
                                            text: root.model_picker_open ? "▴" : "▾";
                                            color: #71717a;
                                            font-size: 9px;
                                            vertical-alignment: center;
                                        }
                                    }

                                    model_touch := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => {
                                            root.model_picker_open = !root.model_picker_open;
                                            if root.model_picker_open {
                                                root.model_filter = "";
                                                root.filter_models("");
                                                root.model_scroll_index = 0;
                                            }
                                        }
                                    }
                                }

                                send_btn := Rectangle {
                                    width: 26px;
                                    height: 24px;
                                    border-radius: 6px;
                                    background: root.composer_text != "" ? #38bdf8 : #242434;

                                    Text {
                                        text: "↑";
                                        color: root.composer_text != "" ? #000000 : #71717a;
                                        font-size: 13px;
                                        font-weight: 700;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                        width: 100%;
                                        height: 100%;
                                    }

                                    TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => {
                                            if (root.composer_text != "") {
                                                root.submit_message(root.composer_text);
                                                root.composer_text = "";
                                            }
                                        }
                                    }
                                }
                            }

                            // Lower Right: Enter shortcut
                            Text {
                                text: "↵ Enter";
                                color: #52525b;
                                font-size: 11px;
                                vertical-alignment: center;
                            }
                        }
                    }
                }

                // Floating Directory Selector (Outside & Above Chat Box)
                dir_btn := Rectangle {
                    x: chat_box.x;
                    y: chat_box.y - self.height - 8px;
                    height: 26px;
                    border-radius: 6px;
                    background: dir_touch.pressed ? #2c2c3e : (dir_touch.has-hover ? #242434 : #181822);
                    border-width: 1px;
                    border-color: dir_touch.has-hover ? #38bdf8 : #2e2e42;

                    HorizontalLayout {
                        padding-left: 9px;
                        padding-right: 9px;
                        spacing: 6px;
                        alignment: center;

                        // Crisp vector folder icon
                        Rectangle {
                            width: 13px;
                            height: 11px;
                            y: 7px;

                            // Folder tab
                            Rectangle {
                                x: 0px;
                                y: 0px;
                                width: 5px;
                                height: 3px;
                                background: dir_touch.has-hover ? #38bdf8 : #a1a1aa;
                                border-top-left-radius: 1px;
                                border-top-right-radius: 1px;
                            }
                            // Folder body
                            Rectangle {
                                x: 0px;
                                y: 2px;
                                width: 13px;
                                height: 9px;
                                border-radius: 2px;
                                background: dir_touch.has-hover ? #38bdf8 : #a1a1aa;
                            }
                        }

                        Text {
                            text: root.workspace_name;
                            color: dir_touch.has-hover ? #38bdf8 : #f4f4f5;
                            font-size: 11px;
                            font-weight: 600;
                            vertical-alignment: center;
                            overflow: elide;
                            max-width: 65px;
                        }

                        Text {
                            text: "▾";
                            color: #71717a;
                            font-size: 9px;
                            vertical-alignment: center;
                        }
                    }

                    dir_touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            root.select_directory();
                        }
                    }
                }

                // Backdrop to close picker on outside click
                TouchArea {
                    visible: root.model_picker_open;
                    width: 100%;
                    height: 100%;
                    clicked => {
                        root.model_picker_open = false;
                    }
                }

                // Anchored Dropdown Menu for Model Changing (Instant Single-View)
                Rectangle {
                    visible: root.model_picker_open;
                    x: max(16px, min(parent.width - self.width - 16px, chat_box.x + 12px));
                    y: max(16px, chat_box.y - self.height - 8px);
                    width: 360px;
                    height: 330px;
                    border-radius: 10px;
                    background: #181822;
                    border-width: 1px;
                    border-color: #38384c;
                    clip: true;

                    VerticalLayout {
                        padding: 10px;
                        spacing: 8px;

                        // Header & Provider Tabs Strip
                        VerticalLayout {
                            spacing: 6px;

                            HorizontalLayout {
                                alignment: space-between;

                                Text {
                                    text: "PROVIDERS";
                                    color: #71717a;
                                    font-size: 10px;
                                    font-weight: 700;
                                    vertical-alignment: center;
                                }

                                Text {
                                    text: root.available_models.length + " models";
                                    color: #52525b;
                                    font-size: 10px;
                                    vertical-alignment: center;
                                }
                            }

                            HorizontalLayout {
                                spacing: 6px;

                                for prov in root.available_providers : Rectangle {
                                    height: 24px;
                                    border-radius: 4px;
                                    background: p_touch.has-hover ? #252536 : (root.selected_provider == prov ? #28283c : transparent);
                                    border-width: 1px;
                                    border-color: root.selected_provider == prov ? #38bdf8 : #2e2e40;

                                    HorizontalLayout {
                                        padding-left: 8px;
                                        padding-right: 8px;
                                        spacing: 5px;
                                        alignment: center;

                                        Text {
                                            text: "●";
                                            color: root.selected_provider == prov ? #22c55e : #52525b;
                                            font-size: 7px;
                                            vertical-alignment: center;
                                        }
                                        Text {
                                            text: prov;
                                            color: root.selected_provider == prov ? #38bdf8 : #d4d4d8;
                                            font-size: 11px;
                                            font-weight: root.selected_provider == prov ? 700 : 500;
                                            vertical-alignment: center;
                                        }
                                    }

                                    p_touch := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => {
                                            root.select_provider(prov);
                                        }
                                    }
                                }
                            }
                        }

                        // Instant search filter input
                        Rectangle {
                            height: 26px;
                            border-radius: 4px;
                            background: #13131c;
                            border-width: 1px;
                            border-color: filter_input.has-focus ? #38bdf8 : #282838;

                            HorizontalLayout {
                                padding-left: 8px;
                                padding-right: 8px;
                                spacing: 6px;

                                Text {
                                    text: "🔍";
                                    font-size: 10px;
                                    vertical-alignment: center;
                                }

                                filter_input := TextInput {
                                    text <=> root.model_filter;
                                    color: #f4f4f5;
                                    font-size: 11px;
                                    vertical-alignment: center;
                                    edited => {
                                        root.filter_models(self.text);
                                    }
                                }

                                if root.model_filter != "" : Rectangle {
                                    width: 16px;
                                    height: 16px;
                                    border-radius: 8px;
                                    background: clear_touch.has-hover ? #2e2e42 : transparent;

                                    Text {
                                        text: "✕";
                                        color: #71717a;
                                        font-size: 9px;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                        width: 100%;
                                        height: 100%;
                                    }

                                    clear_touch := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => {
                                            root.model_filter = "";
                                            root.filter_models("");
                                        }
                                    }
                                }
                            }
                        }

                        Rectangle { height: 1px; background: #262634; }

                        // Static 8-row viewport with direct row wheel forwarding and drag scrollbar
                        Rectangle {
                            vertical-stretch: 1;

                            wheel_touch := TouchArea {
                                width: 100%;
                                height: 100%;
                                scroll-event(event) => {
                                    let max_scroll = max(0, root.available_models.length - 8);
                                    let step = event.delta_y < 0 ? 3 : -3;
                                    root.model_scroll_index = max(0, min(max_scroll, root.model_scroll_index + step));
                                    return accept;
                                }
                            }

                            HorizontalLayout {
                                width: 100%;
                                height: 100%;
                                spacing: 4px;

                                VerticalLayout {
                                    horizontal-stretch: 1;
                                    spacing: 1px;

                                    for offset in 8 : ModelRow {
                                        property <int> item_idx: root.model_scroll_index + offset;
                                        is_active: item_idx >= 0 && item_idx < root.available_models.length;
                                        model_name: self.is_active ? root.available_models[item_idx] : "";
                                        is_selected: self.is_active && root.model_name == self.model_name;
                                        clicked => {
                                            if self.is_active {
                                                root.select_model(self.model_name);
                                            }
                                        }
                                        scrolled(step) => {
                                            let max_scroll = max(0, root.available_models.length - 8);
                                            root.model_scroll_index = max(0, min(max_scroll, root.model_scroll_index + step));
                                        }
                                    }
                                }

                                if root.available_models.length > 8 : Rectangle {
                                    width: 6px;
                                    background: #14141e;
                                    border-radius: 3px;

                                    thumb := Rectangle {
                                        width: 6px;
                                        y: (parent.height - self.height) * root.model_scroll_index / max(1, root.available_models.length - 8);
                                        height: max(24px, parent.height * 8 / max(1, root.available_models.length));
                                        border-radius: 3px;
                                        background: scroll_touch.pressed ? #38bdf8 : #4a4a62;
                                    }

                                    scroll_touch := TouchArea {
                                        mouse-cursor: pointer;
                                        moved => {
                                            let max_scroll = max(0, root.available_models.length - 8);
                                            let avail_h = max(1px, parent.height - thumb.height);
                                            let pos = max(0px, min(avail_h, self.mouse-y));
                                            root.model_scroll_index = min(max_scroll, max(0, round(pos / avail_h * max_scroll)));
                                        }
                                        clicked => {
                                            let max_scroll = max(0, root.available_models.length - 8);
                                            let avail_h = max(1px, parent.height - thumb.height);
                                            let pos = max(0px, min(avail_h, self.mouse-y));
                                            root.model_scroll_index = min(max_scroll, max(0, round(pos / avail_h * max_scroll)));
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }

            // Right Splitter (Resize handle)
            if root.right_sidebar_open : Splitter {
                moved(delta) => {
                    root.right_sidebar_width = max(140px, min(500px, root.right_sidebar_width - delta));
                }
            }

            // 3. Right Sidebar
            if root.right_sidebar_open : Rectangle {
                width: root.right_sidebar_width;
                background: #15151c;

                VerticalLayout {
                    padding: 10px;
                    spacing: 8px;

                    // Header with title
                    HorizontalLayout {
                        alignment: start;
                        Text {
                            text: "CONTEXT";
                            color: #71717a;
                            font-size: 10px;
                            font-weight: 700;
                            vertical-alignment: center;
                        }
                    }

                    // Clean empty context panel body
                    Rectangle {
                        vertical-stretch: 1;
                    }
                }
            }
        }
    }
}
